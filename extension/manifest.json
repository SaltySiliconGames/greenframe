{
  "manifest_version": 3,
  "name": "GreenFrame",
  "version": "0.1.0",
  "description": "Sends Xbox Remote Play's video frames from xbox.com/play to SmoovPlay through the GreenFrame bridge. A backup for the GreenFrame app.",
  "content_scripts": [
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://xbox.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://xbox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
